Package: ofemeantest
Type: Package
Title: On Farm Experimentation Mean Test
Version: 0.0.900-1
Authors@R:
    c(
      person("Mariano", "Córdoba", email = "marianoacba@agro.unc.edu.ar", 
             role = c("aut", "cre")),
      person("Pablo", "Paccioretti", email = "pablopaccioretti@agro.unc.edu.ar", 
             role = c("aut")),
